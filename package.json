{
  "name": "enterprise-cyber-range-php2shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A genuine dual-guest v86 cyber range for CVE-2026-109618 investigation",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run assets:runtime && vite --host 0.0.0.0",
    "build": "npm run assets:runtime && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:guest",
    "test:unit": "vitest run",
    "test:guest": "python3 -m unittest discover -s image-build/tests -p 'test_*.py'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:guest": "playwright test --config playwright.guest.config.ts",
    "lint": "tsc -b --pretty false",
    "assets:runtime": "node scripts/prepare-runtime.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:manifest": "node scripts/generate-asset-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "v86": "0.5.472"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
