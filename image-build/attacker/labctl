#!/bin/sh
# Actual attacker-guest diagnostics consumed by the browser lifecycle manager.
set -u
case "${1:-status}" in
  ready)
    addr="$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}')"
    python_bin="$(command -v python3 || command -v python3.6 || true)"
    proxy=absent
    if [ -n "$python_bin" ]; then
      if http_proxy= HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= all_proxy= curl -fsS --max-time 3 http://127.0.0.1:8081/api/state >/tmp/range-proxy-state.json 2>/dev/null; then
        proxy=running
      fi
    fi
    display=absent
    if [ -e /tmp/.X11-unix/X0 ] && { pidof Xvesa >/dev/null 2>&1 || pidof Xorg >/dev/null 2>&1; }; then
      display=running
    fi
    printf '{"machine":"attacker","os":"%s","arch":"%s","address":"%s","python":"%s","proxy":"%s","display":"%s"}\n' \
      "$(cat /etc/os-release 2>/dev/null | sed -n 's/^PRETTY_NAME=//p' | tr -d '"' | head -n 1)" \
      "$(uname -m)" "$addr" "$python_bin" "$proxy" "$display"
    [ "$addr" = "192.168.10.10/24" ] && [ "$proxy" = running ] && [ "$display" = running ]
    ;;
  tools)
    for tool in ip ping curl wget python3 python3.6 nano vi dillo-beta dillo xterm aterm; do
      path="$(command -v "$tool" 2>/dev/null || true)"
      [ -n "$path" ] && printf '%s\t%s\n' "$tool" "$path"
    done
    ;;
  proxy-state)
    http_proxy= HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= all_proxy= curl -fsS --max-time 5 http://127.0.0.1:8081/api/state
    ;;
  evidence)
    if [ -f "$HOME/lab-evidence/requests.jsonl" ]; then
      tail -c 1048576 "$HOME/lab-evidence/requests.jsonl"
    fi
    ;;
  *)
    echo "usage: labctl ready|tools|proxy-state|evidence" >&2
    exit 2
    ;;
esac
