#!/bin/sh
# Genuine target service/network initialization inside Alpine.
mkdir -p /run/cyber-range /run/apache2 /var/log/apache2
chmod 0750 /run/cyber-range
chmod 0755 /run/apache2
date +%s >/run/cyber-range/session-start
chmod 0644 /run/cyber-range/session-start

# Docker's generated hosts/hostname data is not a stable guest identity, and
# the runtime /run tree is intentionally absent from the initramfs. Apache
# resolves its local identity while initializing listeners, so provide real
# loopback and numeric host mappings before starting it; no DNS is required.
hostname assessment-target
cat >/etc/hosts <<'EOF'
127.0.0.1 localhost localhost.localdomain
192.168.10.55 assessment-target
EOF
ip link set lo up 2>/dev/null || ifconfig lo up
ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true

modprobe ne2k-pci 2>/dev/null || true
ip link set eth0 up 2>/dev/null || ifconfig eth0 up
ip addr flush dev eth0 2>/dev/null || true
ip addr add 192.168.10.55/24 dev eth0 2>/dev/null || ifconfig eth0 192.168.10.55 netmask 255.255.255.0
ip route del default 2>/dev/null || true
: >/etc/resolv.conf

touch /var/log/apache2/access.log /var/log/apache2/error.log /var/log/apache2/php-error.log
chown root:lab /var/log/apache2/*.log
chmod 0640 /var/log/apache2/*.log
chown root:lab /var/log/apache2
chmod 0750 /var/log/apache2
chown root:apache /var/www/html
chmod 0775 /var/www/html

# Validate here, then let OpenRC start apache2 after this service. Apache's
# stock init script requires net, which cyber-range provides only after the
# static addressing above has really been applied. The browser independently
# polls the HTTP health endpoint; this setup service must not wait on a daemon
# that is deliberately ordered after it.
httpd -t || { echo 'CYBER_RANGE_TARGET_FAILED apache_config'; exit 1; }
echo 'CYBER_RANGE_NETWORK_READY address=192.168.10.55 loopback=127.0.0.1'
