#!/bin/sh
# These mountpoints are deliberately pruned from the exported Docker rootfs.
# Recreate them before mounting; otherwise a silent failed /proc or /dev mount
# leaves OpenRC and Apache without a usable runtime environment.
mkdir -p /proc /sys /dev /dev/pts /run
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
exec /sbin/init
